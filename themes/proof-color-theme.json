  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#6D7067",
        "fontStyle": ""
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "delimiter"],
      "settings": {
        "foreground": "#7A766D"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": ["keyword.operator", "storage.type.function.arrow"],
      "settings": {
        "foreground": "#7A766D"
      }
    },
    {
      "scope": [
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.relational"
      ],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": ["string", "punctuation.definition.string", "attribute.value"],
      "settings": {
        "foreground": "#315F86"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.ts",
        "keyword.control.tsx",
        "keyword.control.js",
        "keyword.control.jsx",
        "keyword.control.vue"
      ],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#85691F"
      }
    },
    {
      "scope": ["entity.name.function", "meta.function-call"],
      "settings": {
        "foreground": "#3D755D"
      }
    },
    {
      "scope": ["support.function", "support.constant", "support.variable"],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "type.identifier"
      ],
      "settings": {
        "foreground": "#5F6AC2"
      }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": {
        "foreground": "#2F312D"
      }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": {
        "foreground": "#2F312D"
      }
    },
    {
      "scope": ["variable.other.constant", "meta.definition.variable"],
      "settings": {
        "foreground": "#2F312D"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#514F49"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "meta.property-name",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#2F312D"
      }
    },
    {
      "scope": [
        "variable.css",
        "variable.scss",
