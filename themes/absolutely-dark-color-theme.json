        "punctuation.definition.template-expression.end"
      ],
      "settings": { "foreground": "#DC967A" }
    },
    {
      "scope": ["markup.inline.raw", "markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#AA97C1" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#DC967A", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#D8D3C9", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#D8D3C9", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "message.error"],
      "settings": { "foreground": "#F07F75" }
    }
  ]
}
