  "semanticTokenColors": {
    "namespace": "#B5A0C2",
    "variable": "#BCA88A",
    "variable.readonly": "#BCA88A",
    "variable.defaultLibrary": "#9B8AB3",
    "parameter": "#C59B7C",
    "property": "#B7A069",
    "property.readonly": "#B7A069",
    "function": "#A6BF74",
    "function.defaultLibrary": "#9B8AB3",
    "method": "#A6BF74",
    "method.defaultLibrary": "#9B8AB3",
    "interface": "#9B8AB3",
    "type": "#9B8AB3",
    "class": "#9B8AB3",
    "enum": "#9B8AB3",
    "typeParameter": "#9B8AB3",
    "enumMember": "#B7A069",
    "number": "#D0A45F",
    "regexp": "#9B8AB3",
    "decorator": "#D59A73",
    "component": "#C8B1CF",
    "component:vue": "#C8B1CF"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#9C9274", "fontStyle": "" }
    },
    {
      "scope": ["punctuation", "meta.brace", "delimiter"],
      "settings": { "foreground": "#B8AA83" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.new"],
      "settings": { "foreground": "#D59A73" }
    },
    {
      "scope": ["keyword.operator", "storage.type.function.arrow"],
      "settings": { "foreground": "#D59A73" }
    },
    {
      "scope": ["keyword.operator.logical", "keyword.operator.comparison", "keyword.operator.relational"],
      "settings": { "foreground": "#D59A73" }
    },
    {
      "scope": ["string", "punctuation.definition.string", "attribute.value"],
      "settings": { "foreground": "#B8AA83" }
    },
    {
      "scope": ["meta.attribute.class.html string", "meta.attribute.class.html.vue string"],
      "settings": { "foreground": "#D99A83" }
    },
    {
      "scope": [
        "meta.attribute.unrecognized string",
        "meta.attribute.unrecognized.html string",
        "meta.attribute.unrecognized.html.vue string",
        "meta.attribute.structure.html string",
        "meta.attribute.structure.html.vue string"
      ],
      "settings": { "foreground": "#D99A83" }
    },
    {
      "scope": ["string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#D59A73" }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.ts",
        "keyword.control.tsx",
        "keyword.control.js",
        "keyword.control.jsx",
        "keyword.control.vue"
      ],
      "settings": { "foreground": "#D59A73" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#D0A45F" }
    },
    {
      "scope": ["entity.name.function", "meta.function-call"],
      "settings": { "foreground": "#A6BF74" }
    },
    {
      "scope": ["support.function", "support.constant", "support.variable"],
      "settings": { "foreground": "#D0A45F" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "type.identifier"
      ],
      "settings": { "foreground": "#B5A0C2" }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#BCA88A" }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": { "foreground": "#B7A069" }
    },
    {
      "scope": ["variable.other.constant", "meta.definition.variable"],
      "settings": { "foreground": "#BCA88A" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#C8B1CF" }
    },
    {
      "scope": ["variable.other.property", "meta.property-name", "support.type.property-name.json"],
      "settings": { "foreground": "#B7A069" }
    },
    {
      "scope": ["variable.css", "variable.scss", "variable.less", "support.type.custom-property.name.css"],
      "settings": { "foreground": "#BCA88A" }
    },
    {
      "scope": ["entity.name.tag", "tag.html"],
      "settings": { "foreground": "#A6BF74" }
    },
    {
      "scope": ["support.class.component", "support.class.component.vue", "entity.name.type.class.vue"],
      "settings": { "foreground": "#B5A0C2" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html.vue"],
      "settings": { "foreground": "#D0A45F" }
    },
    {
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#B8AA83" }
    },
    {
      "scope": ["source.css support.type.property-name", "source.scss support.type.property-name", "source.less support.type.property-name"],
      "settings": { "foreground": "#B7A069" }
    },
    {
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.class.scss", "entity.other.attribute-name.class.less"],
      "settings": { "foreground": "#B5A0C2" }
    },
    {
      "scope": [
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.id.scss",
        "entity.other.attribute-name.id.less",
        "punctuation.definition.interpolation.begin.html.vue",
        "punctuation.definition.interpolation.end.html.vue",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": { "foreground": "#B8AA83" }
    },
    {
      "scope": ["markup.inline.raw", "markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#D99A83" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#D59A73", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#EEE4C8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#EEE4C8", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "message.error"],
      "settings": { "foreground": "#F07F75" }
    }
  ]
}
